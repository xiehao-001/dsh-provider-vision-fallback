{
  "name": "@eduwork/dsh-provider-vision-fallback",
  "version": "0.1.0",
  "description": "Adds image reading to a text-only enterprise model: a vision model describes the image and the main model receives untrusted text evidence.",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MulanPSL-2.0 AND MIT",
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <4.1.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.2-rc.1",
    "@eduwork/dsh-oidc": ">=0.3.4"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSING.md",
    "*.md",
    "*.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
